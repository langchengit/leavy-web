# Google Maps (Routes API). Without it, the app runs in demo mode.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (Project Settings → API / Connect). Accounts, settings sync and calendar links.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in and Google Calendar (Google Cloud Console → Credentials → Web application client)
VITE_GOOGLE_WEB_CLIENT_ID=
